.claude/*

# Local secret overrides — never commit these.
bash/.bashrc.local
*.local

# Cline — credential-bearing files. Never synced by sync-cline.sh, but keep a
# second line of defence in case one is ever copied in by hand.
cline/secrets.json
cline/providers.json
cline/config.json

# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Claude Code の TASK_FILE はリポジトリに置かない（~/.local/share/harness/tasks/ へ）
.claude/docs/decisions/*
!.claude/docs/decisions/.gitkeep

