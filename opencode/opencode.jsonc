{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama-cloud/deepseek-v4.1-flash",
  "default_agent": "build",
  "permission": "allow",
  // API キーは ~/.bashrc.local で OLLAMA_API_KEY を export する — この設定ファイルには直書きしない。
  "provider": {
    "ollama-cloud": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Cloud",
      "options": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": { "name": "deepseek-v4.1-flash" }
      }
    }
  },
  "mcp": {
    "linear": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "enabled": true
    },
    // 外部リサーチ用（Gemini CLI の後継）。API キーは ~/.bashrc.local で
    // FIRECRAWL_API_KEY を export する — この設定ファイルには直書きしない。
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "environment": {
        "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
      },
      "enabled": true
    }
  }
}
